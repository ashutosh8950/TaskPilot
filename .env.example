# Database (copy from Render PostgreSQL service)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars

# Environment
NODE_ENV=development

# Allow public self-service registration for the first user or when disabled.
ALLOW_REGISTRATION=true

# Port (Render sets this automatically)
PORT=3000

# Optional CORS origins for a separate frontend or custom domain.
# Keep empty when Express serves public/index.html from the same Render service.
FRONTEND_URL=
ALLOWED_ORIGINS=

# Optional DB pool tuning
DB_POOL_MAX=5

# Render's internal PostgreSQL certificate requires this to be false.
# DB_REJECT_UNAUTHORIZED=false
